# Copy to .env — these are PUBLIC values baked into the app. Never put the Gemini key here.
EXPO_PUBLIC_API_URL=https://label-lens-api.<your-subdomain>.workers.dev
EXPO_PUBLIC_APP_TOKEN=same-random-string-as-worker-APP_TOKEN
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxx
# Optional: RevenueCat debug logs in a release build (dev builds always log).
# EXPO_PUBLIC_RC_DEBUG=1
